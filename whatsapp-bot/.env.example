# Variables de entorno para el bot de WhatsApp (Railway)
# Copia este archivo como .env y llena los valores

# Clave secreta para proteger los endpoints del bot
# Puede ser cualquier texto largo y aleatorio, ej: torre44_bot_2026_secreto
BOT_API_KEY=torre44_bot_secreto_aqui

# Puerto (Railway lo pone automáticamente, no tocar)
PORT=3001
